#!/usr/bin/env python3
"""사용자 크롬 탭 하나를 조작한다.  pc [--pid P] [--tab W:T] <cmd> [arg]
cmd: tabs | text [N] | click <글자> | go <url> | js <코드|-> | form
기본 pid 는 --user-data-dir 없는(=사용자) 크롬, 탭은 0:0.
"""
import json, os, subprocess, sys
HERE = os.path.dirname(os.path.abspath(__file__))
CJ = subprocess.run([os.path.join(HERE, "build.sh")], capture_output=True, text=True).stdout.strip()
args = sys.argv[1:]
pid, w, t = os.environ.get("CJ_PID"), "0", "0"
while args and args[0].startswith("--"):
    if args[0] == "--pid": pid = args[1]
    elif args[0] == "--tab": w, t = args[1].split(":")
    args = args[2:]
if not pid:
    for p in subprocess.run(["pgrep", "-x", "Google Chrome"], capture_output=True, text=True).stdout.split():
        if "--user-data-dir" not in subprocess.run(["ps", "-o", "command=", "-p", p], capture_output=True, text=True).stdout:
            pid = p; break
if not pid: sys.exit("사용자 크롬을 못 찾음")
def js(code):
    r = subprocess.run([CJ, pid, "js", w, t, "-"], input=code, capture_output=True, text=True)
    return (r.stdout + r.stderr).strip()
cmd, arg = args[0], (args[1] if len(args) > 1 else "")
VIS = "[...document.querySelectorAll('button, a, [role=button], [role=menuitem], [role=tab], [role=radio], [role=checkbox], [role=option], label')].filter(e => e.offsetParent !== null)"
if cmd == "tabs":
    print(subprocess.run([CJ, pid, "tabs"], capture_output=True, text=True).stdout.strip())
elif cmd == "text":
    print(js("document.body.innerText.slice(0, %d)" % int(arg or 6000)))
elif cmd == "click":
    print(js("(() => { const L = %s; const els = %s.filter(e => ((e.innerText || '') + ' ' + (e.getAttribute('aria-label') || '')).includes(L)).sort((a, b) => (a.innerText || '').length - (b.innerText || '').length); if (!els.length) return 'NOTFOUND'; els[0].scrollIntoView({block: 'center'}); els[0].click(); return 'clicked(' + els.length + '): ' + (els[0].innerText || els[0].getAttribute('aria-label') || '').trim().slice(0, 80) + (els[0].disabled ? ' [disabled]' : ''); })()" % (json.dumps(arg, ensure_ascii=False), VIS)))
elif cmd == "go":
    print(subprocess.run([CJ, pid, "go", w, t, arg], capture_output=True, text=True).stdout.strip())
elif cmd == "js":
    print(js(sys.stdin.read() if arg == "-" else arg))
elif cmd == "form":
    print(js("(() => [...document.querySelectorAll('input, textarea, select')].filter(e => e.offsetParent || e.type === 'radio' || e.type === 'checkbox').map(e => [e.tagName, e.type, e.name, e.checked, (e.type === 'password' ? '(hidden)' : (e.value || '').slice(0, 60)), (e.getAttribute('aria-label') || (e.closest('label') || {}).innerText || '').trim().replace(/\\s+/g, ' ').slice(0, 60)].join(' | ')).join('\\n'))()"))
else:
    sys.exit(__doc__)
